[credentials]
# Copy this file to archiveit_credentials.properties (same folder as the script), then fill it in.
# archiveit_credentials.properties is listed in .gitignore, so it is never committed. Keep it private.
#
# An Archive-It login for UNI's account (the one you use at partner.archive-it.org).
username=REPLACE_WITH_USERNAME
password=REPLACE_WITH_PASSWORD
