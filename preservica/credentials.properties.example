[credentials]
# Copy this file to credentials.properties (same folder as the script), then fill it in.
# credentials.properties is listed in .gitignore, so it is never committed. Keep it private.
#
# Preservica login: ideally the service account, with Read Metadata on the records.
# It must be a Preservica account with its own password, not a university single sign-on login.
username=service-account@uni.edu
password=REPLACE_WITH_PASSWORD

# Your Preservica server host name only: no https:// and no trailing slash.
# Not the public access site (uni.access.preservica.com), which has no API.
server=us.preservica.com

# Rod Library's tenant code.
tenant=UNIOWA

# Only needed if this account uses two-factor authentication:
# remove the # below and add the 2FA secret key.
#twoFactorToken=REPLACE_WITH_2FA_SECRET
