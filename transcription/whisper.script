#!/usr/bin/env bash
#SBATCH --job-name=whisper
#SBATCH --output=%J.out
#SBATCH --error=%J.err
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8

# Move into the directory with your audio
# *change name from audio if named something else

cd "audio" || exit 1


# WHISPER_LOC -> The full path to your python
#                virtual environment

WHISPER_LOC="/data/$USER/pve"


# MODEL_SIZE  -> The size of the whisper model
#         (tiny, base, small, medium, large)

MODEL_SIZE="large"


######################################
## No need to modify anything below ##
######################################

mkdir -p transcripts
shopt -s nullglob
max_jobs=$SLURM_CPUS_PER_TASK

for file in *; do

    case "$file" in
        *.mp3|*.wav|*.m4a|*.aac|*.flac|*.ogg|*.wma|*.mp4|*.mkv|*.mov|*.webm)

            "$WHISPER_LOC/bin/whisper" \
                "$file" \
                --model "$MODEL_SIZE" \
                --fp16 False \
                --output_dir transcripts &

            # limit parallel jobs
            while [ "$(jobs -r | wc -l)" -ge "$max_jobs" ]; do
                sleep 1
            done
            ;;
        *)
            # ignore mismatching file extensions
            ;;
    esac
done
wait
